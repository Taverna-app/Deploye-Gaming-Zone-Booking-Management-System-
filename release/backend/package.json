{
  "name": "-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Zobix Gaming Zone Booking & Management SaaS - API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seed.ts",
    "demo:rotate": "tsx scripts/rotate-demo-passwords.ts",
    "images:import": "tsx scripts/import-store-images.ts",
    "storage:previews": "tsx scripts/migrate-storage-previews.ts",
    "seed:showcase": "tsx src/seed/seedShowcase.ts",
    "create-superadmin": "tsx src/seed/createSuperAdmin.ts",
    "create-superadmin:prod": "node dist/seed/createSuperAdmin.js",
    "bench": "tsx scripts/bench.ts",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "dev:memory": "tsx src/dev/memory.ts",
    "dev:showcase": "tsx src/dev/memory.ts --showcase",
    "dev:showcase:rehearsal": "tsx src/dev/memory.ts --showcase --placeholder-prices"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
